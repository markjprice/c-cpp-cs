# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Linker files
*.ilk

# Debugger Files
*.pdb

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# debug information files
*.dwo


# ---------------------------------------------------------------
# Unity
# ---------------------------------------------------------------

# Folders generated by the Unity Editor (regenerated automatically)
**/[Ll]ibrary/
**/[Tt]emp/
**/[Oo]bj/
**/[Bb]uild/
**/[Bb]uilds/
**/[Ll]ogs/
**/[Uu]ser[Ss]ettings/

# Memory Profiler captures and recordings
**/[Mm]emoryCaptures/
**/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!**/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# **/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
**/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / VS Code / Rider caches and generated project files
.vs/
.vscode/
.idea/
.utmp/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files for solution/project files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt
**/[Aa]ssets/[Ss]treamingAssets/aa.meta
**/[Aa]ssets/[Ss]treamingAssets/aa/*

# Builds
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# Crash reports
crashlytics-build.properties
**/[Aa]ssets/[Pp]lugins/[Aa]ndroid/*.tmp

# Addressables
**/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
**/[Aa]ssets/[Ss]treamingAssets/aa.meta
**/[Aa]ssets/[Ss]treamingAssets/aa/*

# Gradle / Android / iOS build output
*.gradle
**/[Pp]latforms/*/build/
**/[Ii]os[Bb]uild/
**/[Aa]ndroid[Bb]uild/
**/[Xx]code[Pp]roject/

# Code coverage results
/[Cc]ode[Cc]overage/

# Burst and IL2CPP generated output
*_BurstDebugInformation_DoNotShip*
*_BackUpThisFolder_ButDontShipItWithYourGame*
*_BurstDebugInformation_DoNotShip.meta
*_BackUpThisFolder_ButDontShipItWithYourGame.meta

# Plastic SCM / Collab leftovers
.collabignore
.plastic/

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ---------------------------------------------------------------
# Note: the global *.dll / *.pdb / *.lib / *.so / *.a rules above
# also match third-party plugins inside a Unity project. If you
# keep native or managed plugins in version control, re-include
# them explicitly, for example:
#
# !**/[Aa]ssets/[Pp]lugins/**/*.dll
# !**/[Aa]ssets/[Pp]lugins/**/*.so
# !**/[Aa]ssets/[Pp]lugins/**/*.dylib
# !**/[Aa]ssets/[Pp]lugins/**/*.a
# !**/[Aa]ssets/[Pp]lugins/**/*.lib
# ---------------------------------------------------------------
